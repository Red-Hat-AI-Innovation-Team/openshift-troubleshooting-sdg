# === API Keys ===
OPENAI_API_KEY="sk-..."

# === Models ===
# TEACHER_MODEL=""      # optional LiteLLM model id; the default is set in src/open_lightspeed/config.py

# === Service URLs ===
LIGHTSPEED_URL="http://localhost:8080/v1/query"
MCP_SERVER_URL="http://localhost:8085/mcp"

# === Scenario Generation ===
NUM_VARIANTS=4          # Variants per failure category (15 categories × this = total candidates)

# === Distillation ===
NUM_SAMPLES=10          # Question candidates per distillation run
TOOL_K=3                # Number of tools sampled per question (1=single-tool, 2-3=typical, 4-5=complex)
